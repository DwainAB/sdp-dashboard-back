# ============================================================================
# SDP Dashboard Back — Variables d'environnement (projet autonome)
# Copie ce fichier vers `.env` (gitignoré, jamais commité) et remplis les valeurs.
# ============================================================================

# Port d'écoute du serveur Express (Railway fournit PORT automatiquement).
PORT=3001

# --- MySQL ----------------------------------------------------------------
# Exemple Railway : mysql.railway.internal / sakura.proxy.rlwy.net
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=sdp_dashboard

# --- EMAILS (Resend) -------------------------------------------------------
# Clé API Resend (https://resend.com/api-keys).
RESEND_API_KEY=re_your_resend_api_key
# Expéditeur vérifié sur Resend.
RESEND_FROM_EMAIL=noreply@sdp-paris.com
